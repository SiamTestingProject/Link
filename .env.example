# Copy this file to .env and fill in your own values.
# Do not commit the resulting .env file.

# Telegram API credentials from my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Main bot from BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional extra BotFather tokens, separated by spaces or commas.
# Keep all tokens on this one quoted value.
MULTI_BOT_TOKENS=""

# Owner and access control
OWNER_ID=
AUTH_USERS=""
ALLOWED_USER_IDS=""

# Optional storage/bin channel for direct files sent to the bot in private DM
TELEGRAM_CHANNEL_ID=
SECRET_CODE_LENGTH=24

# MongoDB
DATABASE_URL=
DATABASE_NAME=OmniArchiver

# Public URL used in generated stream/download links
# Alwaysdata Free example: https://<account>.alwaysdata.net
BASE_URL=

# Do not set BIND_ADDRESS or PORT on Alwaysdata User Program deployments.
# Alwaysdata injects IP and PORT automatically.
#
# Optional local/Docker overrides:
# BIND_ADDRESS=0.0.0.0
# PORT=8080
